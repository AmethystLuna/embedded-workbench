#!/usr/bin/env bash
# SessionStart hook for embedded-workbench.
# Reads session-start-content.md, wraps it in the Claude Code hook JSON envelope,
# and prints that on stdout. All content lives in the .md file, so no payload
# text is ever embedded in this script.
#
# Escaping is pure bash parameter substitution — deliberately no sed/awk. Text
# tools disagree across platforms: a CRLF content file survives the pipeline
# only where sed happens to run in text mode (verified: Git for Windows strips
# the CR, GNU sed does not), and awk dialects disagree about "\n" inside a
# printf format. An encoder that emits invalid JSON silently loses the whole
# injection, so it must not depend on either. This mirrors the reference
# implementation in obra/superpowers.
#
# hooks.json runs this as `bash <path>` for two reasons: the executable bit is
# then irrelevant, and the extensionless name keeps Claude Code's Windows
# auto-detection (which prepends "bash" to any command containing ".sh") from
# adding a second interpreter.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONTENT_FILE="$SCRIPT_DIR/session-start-content.md"

emit() {
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$1"
}

if [ ! -f "$CONTENT_FILE" ]; then
    emit "embedded-workbench active (content file missing)"
    exit 0
fi

# escape_for_json: one C-level pass per substitution (far faster than a
# character loop). Order matters — backslash first, or it would re-escape the
# backslashes the later substitutions introduce. `\n`, `\r`, `\t`, `\b` and
# `\f` have short JSON escapes; the remaining C0 controls JSON forbids inside a
# string get `\u` forms. A NUL cannot reach a bash string at all.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\b'/\\b}"
    s="${s//$'\f'/\\f}"
    s="${s//$'\v'/\\u000b}"
    s="${s//$'\a'/\\u0007}"
    s="${s//$'\e'/\\u001b}"
    printf '%s' "$s"
}

# Command substitution drops the file's trailing newline(s), so the injected
# string carries no trailing "\n" — which is what the payload intends.
CONTENT="$(cat "$CONTENT_FILE")"
emit "$(escape_for_json "$CONTENT")"
exit 0
